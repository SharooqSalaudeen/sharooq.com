    "cheerio": "^1.0.0-rc.10",
    "crypto-hash": "^2.0.1",
    "dayjs": "^1.10.7",
    "disqus-react": "1.1.7",
    "email-validator": "^2.0.4",
    "flexsearch": "^0.7.21",
    "fs": "^0.0.1-security",
    "lodash.throttle": "^4.1.1",
    "next": "15.5.23",
    "nodemailer": "^6.7.2",
    "probe-image-size": "^7.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-medium-image-zoom": "5.4.8",
