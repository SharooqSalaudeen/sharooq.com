    "@types/flexsearch": "^0.7.3",
    "@types/lodash": "^4.14.178",
    "@types/node": "24.2.0",
    "@types/nodemailer": "^6.4.4",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/refractor": "^3.0.2",
    "@types/rss": "^0.0.29",
    "@types/sanitize-html": "^2.6.2",
