    "eslint": "8.57.1",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "next-sitemap": "^2.1.14",
    "postcss": "^8.4.6",
    "postcss-color-mod-function": "^3.0.3",
    "postcss-easy-import": "^3.0.0",
