{
  "name": "next-cms-ghost",
  "description": "Publish flaring fast blogs with Next.js and Ghost CMS",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "cross-env IS_EXPORT=true next build && npm run postbuild",
    "clean": "rm -rf .cache public/images",
    "format": "prettier --write **/*.{js,ts,tsx}",
    "lint": "eslint . --ext ts --ext tsx --ext js",
    "postbuild": "next-sitemap",
    "serve": "serve out",
    "deploy": "cross-env IS_EXPORT=true next build && npm run postbuild && netlify deploy --prod --dir=out"
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.78",
